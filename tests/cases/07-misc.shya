// 其余特性：函数、异步、异常、可选链、模板字符串、展开、类型标注
const VERSION: string = "1.0"

fn greet(name: string, greeting: string = "你好"): string {
  return `${greeting}，${name}！`
}

fn rest(first: number, ...others: number[]) {
  let total = first
  for v of others {
    total = total + v
  }
  return total
}

async fn fetchHp(): number {
  await @ts{new Promise((resolve) => setTimeout(resolve, 1))}
  return 42
}

fn risky(flag: boolean): string {
  try {
    if flag {
      throw new Error("boom")
    }
    return "ok"
  } catch e {
    return "caught: " + @ts{e.message}
  } finally {
    console log("finally")
  }
}

fn main() {
  console log(greet("世界"))
  console log(greet("shya", "hi"))
  console log(rest(1, 2, 3, 4))

  let arr = [1, 2, 3]
  let copy = [...arr, 4]
  console log(copy @len, copy @values)
  console log(VERSION)

  let obj = { a: 1, b: 2 }
  for k v of @entries(obj) {
    console log(k, v)
  }
  for k of @keys(obj) {
    console log("key", k)
  }

  console log(risky(true))
  console log(risky(false))

  // 倒序 range
  for i of @range 3:0,-1 {
    console log("down", i)
  }

  // 集合上的区间遍历
  for v of arr @range 1:3,1 {
    console log("slice", v)
  }

  // 安全访问
  let maybe = @ts{null}
  console log(maybe @safe getHp)
  console log(maybe ?(1))
}

main()
