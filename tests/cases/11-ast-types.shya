// 宏插槽类型可以是 AST 节点种类
// 见 docs/ast-nodes.md：安全节点都能当类型用，宏模板内部节点除外。
// 类型名就是 AST 节点种类名，严格区分大小写（写 `Str`，不是 `strLit`）。

macro @swapIf(#cond: Compare, #yes: stmt, #no: stmt) {
  if #cond {
    #yes
  } else {
    #no
  }
}

macro @kindOf(#x) {
  @when(#x is Binary) console log("  -> binary")
  @when(#x is Call) console log("  -> call")
  @when(#x is Member) console log("  -> member")
  @when(#x is Str) console log("  -> string literal")
  @when(#x is Num) console log("  -> number literal")
  @when(#x is ArrayLit) console log("  -> array literal")
  @when(#x is TsRaw) console log("  -> @ts block")
  @when(#x is Ident) console log("  -> identifier")
}

macro @inBlock(#b: Block) {
  console log("block start")
  #b
  console log("block end")
}

macro @echoLit(#x: Str) {
  console log("literal is " + #x)
}

fn main() {
  let a = 1

  console log("swapIf:")
  @swapIf(a < 2, console log("  yes"), console log("  no"))
  @swapIf(a > 2, console log("  yes"), console log("  no"))

  console log("kindOf:")
  @kindOf(a + 1)
  @kindOf(a toStr)
  @kindOf("text")
  @kindOf(42)
  @kindOf([1, 2])
  @kindOf(@ts{1 + 1})
  @kindOf(a)

  @inBlock {
    #b: console log("  inside the block")
  }

  @echoLit("hello")
}

main()
