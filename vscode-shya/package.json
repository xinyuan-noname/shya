{
  "name": "shya",
  "displayName": "shya",
  "description": "Language support for shya, a strongly-typed DSL that compiles to ES2026 JavaScript: syntax highlighting, snippets, a formatter, a combined format-and-preview command and a compile command.",
  "publisher": "xinyuan-noname",
  "version": "0.2.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "shya",
    "dsl",
    "javascript",
    "es2026",
    "macros"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:shya"
  ],
  "contributes": {
    "languages": [
      {
        "id": "shya",
        "aliases": [
          "shya",
          "Shya"
        ],
        "extensions": [
          ".shya"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "shya",
        "scopeName": "source.shya",
        "path": "./syntaxes/shya.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "shya",
        "path": "./snippets/shya.json"
      }
    ],
    "configuration": {
      "title": "shya",
      "properties": {
        "shya.compilerPath": {
          "type": "string",
          "default": "shya",
          "markdownDescription": "Path to the shya compiler executable. Defaults to `shya`, which requires it to be on `PATH`; on Windows you probably want something like `D:\\\\project\\\\shya\\\\build\\\\shya.exe`."
        },
        "shya.buildArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "build"
          ],
          "markdownDescription": "Arguments passed to the compiler before the input file. The shya sub-command `build` is the default; use `[\"check\"]` to type-check only."
        },
        "shya.buildOutputExtension": {
          "type": "string",
          "default": ".mjs",
          "description": "Extension used for the -o output file produced by the compile command."
        },
        "shya.indentSize": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 8,
          "description": "Spaces per indentation level used by the formatter."
        },
        "shya.formatOnPreview": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Format the document before opening the preview (`shya: 格式化并预览`). Turn this off to preview exactly what is in the buffer."
        },
        "shya.previewLive": {
          "type": "boolean",
          "default": true,
          "description": "Recompile the preview panel while you type. Turn this off to only refresh on save."
        }
      }
    },
    "commands": [
      {
        "command": "shya.formatAndPreview",
        "title": "格式化并预览",
        "category": "shya",
        "icon": "$(open-preview)"
      },
      {
        "command": "shya.format",
        "title": "格式化文档",
        "category": "shya",
        "icon": "$(edit)"
      },
      {
        "command": "shya.compile",
        "title": "Compile File",
        "category": "shya",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "shya.formatAndPreview",
          "when": "editorLangId == shya",
          "group": "navigation@1"
        },
        {
          "command": "shya.compile",
          "when": "editorLangId == shya",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "shya.formatAndPreview",
          "when": "editorLangId == shya"
        },
        {
          "command": "shya.format",
          "when": "editorLangId == shya"
        }
      ]
    },
    "keybindings": [
      {
        "command": "shya.formatAndPreview",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorLangId == shya"
      }
    ]
  },
  "scripts": {
    "package": "node build-vsix.mjs"
  }
}
